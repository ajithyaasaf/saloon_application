# ==============================================================================
# Saloon Platform — Staging Environment Variables Template
# ==============================================================================
# Copy this file to .env.staging on staging deployment environments.
# Uses test sandbox credentials only.

NODE_ENV=staging
APP_PORT=3000
APP_PREFIX=api
APP_CORS_ORIGINS=https://salon-staging.saloon.godivatech.com,https://admin-staging.saloon.godivatech.com

DATABASE_USER=saloon_staging_user
DATABASE_PASSWORD=replace_with_staging_database_password
DATABASE_NAME=saloon_staging_db
DATABASE_URL=postgresql://saloon_staging_user:replace_with_staging_database_password@postgres:5432/saloon_staging_db?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_staging_redis_password
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=replace_with_staging_redis_password

JWT_ACCESS_SECRET=staging-super-secret-access-token-min-32-chars-long
JWT_REFRESH_SECRET=staging-super-secret-refresh-token-min-32-chars-long

# Razorpay Sandbox Test Credentials
RAZORPAY_KEY_ID=rzp_test_replace_with_sandbox_key
RAZORPAY_KEY_SECRET=replace_with_sandbox_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_sandbox_webhook_secret

# Twilio Staging Sandbox
TWILIO_ACCOUNT_SID=AC_replace_with_staging_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_staging_twilio_auth_token
TWILIO_FROM_NUMBER=+919999999999

# Firebase Staging Project
FIREBASE_PROJECT_ID=saloon-staging-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@saloon-staging-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_STAGING_KEY\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 Staging Storage
R2_ACCOUNT_ID=replace_with_staging_r2_account_id
R2_ACCESS_KEY_ID=replace_with_staging_r2_access_key
R2_SECRET_ACCESS_KEY=replace_with_staging_r2_secret_key
R2_BUCKET_NAME=saloon-staging-assets
R2_PUBLIC_DOMAIN=https://assets-staging.saloon.godivatech.com

NEXT_PUBLIC_API_URL=https://api-staging.saloon.godivatech.com
EXPO_PUBLIC_API_URL=https://api-staging.saloon.godivatech.com
