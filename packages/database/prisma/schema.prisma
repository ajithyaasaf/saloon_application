  @@map("enum_file_status")
}

enum FileVisibility {
  PRIVATE
  PUBLIC
  TENANT
  AUTHENTICATED

  @@map("enum_file_visibility")
}

enum FileCategory {
  PROFILE
  SALON
  STAFF
  SERVICE
  PRODUCT
  GALLERY
  DOCUMENT
  MARKETING
  TEMPORARY
  OTHER

  @@map("enum_file_category")
}


// ==========================================
// DOMAIN MODELS
// ==========================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  phone            String    @unique(map: "uq_users_phone")
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  email            String?   @unique(map: "uq_users_email")
  emailVerified    Boolean   @default(false) @map("email_verified")
  passwordHash     String?   @map("password_hash")
  firstName        String    @map("first_name")
  lastName         String?   @map("last_name")
  displayName      String?   @map("display_name")
  gender           Gender?   @map("gender")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  preferredLanguage String?  @map("preferred_language") @db.VarChar(10)
  timezone         String?   @map("timezone") @db.VarChar(60)
  marketingOptIn   Boolean   @default(false) @map("marketing_opt_in")
  role             UserRole  @default(CUSTOMER)
  isActive         Boolean   @default(true) @map("is_active")
  avatarMediaId    String?   @map("avatar_media_id") @db.Uuid

  // Standard Audit Fields
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid
  version          Int       @default(1)

  // Relations
  salons           Salon[]   @relation("SalonOwner")
  staffProfile     Staff?
  approvedLeaves   StaffLeave[] @relation("LeaveApprover")
  sessions         UserSession[]
  appointments     Appointment[] @relation("CustomerAppointments")
  notifications    Notification[]
  uploadedMedia    Media[]   @relation("MediaUploader")
  auditLogs        AuditLog[]
  priceHistoryChanges BranchServicePriceHistory[] @relation("PriceHistoryChanger")

  customerBookings           Booking[]                  @relation("CustomerBookings")
  cancelledBookings          Booking[]                  @relation("CancelledBookings")
  createdBookings            Booking[]                  @relation("CreatedBookings")
  updatedBookings            Booking[]                  @relation("UpdatedBookings")
  createdBookingItems        BookingItem[]              @relation("CreatedBookingItems")
  updatedBookingItems        BookingItem[]              @relation("UpdatedBookingItems")
  performedStatusHistories   BookingStatusHistory[]     @relation("PerformedStatusHistories")
  customerReservationLocks   BookingReservationLock[]   @relation("CustomerReservationLocks")

  customerPayments           Payment[]                  @relation("CustomerPayments")
  createdPayments            Payment[]                  @relation("CreatedPayments")
  updatedPayments            Payment[]                  @relation("UpdatedPayments")
  createdPaymentTransactions PaymentTransaction[]      @relation("CreatedPaymentTransactions")
  updatedPaymentTransactions PaymentTransaction[]      @relation("UpdatedPaymentTransactions")
  processedRefunds           Refund[]                   @relation("ProcessedRefunds")
  createdRefunds             Refund[]                   @relation("CreatedRefunds")
  updatedRefunds             Refund[]                   @relation("UpdatedRefunds")
  customerInvoices           Invoice[]                  @relation("CustomerInvoices")
  createdInvoices            Invoice[]                  @relation("CreatedInvoices")
  updatedInvoices            Invoice[]                  @relation("UpdatedInvoices")
  paymentAudits              PaymentAudit[]             @relation("PaymentAuditActor")

  customerProfiles           CustomerProfile[]          @relation("CustomerUser")
  blacklistedCustomers       CustomerProfile[]          @relation("BlacklistedByUser")
  createdCustomerProfiles    CustomerProfile[]          @relation("CreatedCustomerProfiles")
  updatedCustomerProfiles    CustomerProfile[]          @relation("UpdatedCustomerProfiles")
  changedCustomerConsents    CustomerConsentHistory[]   @relation("ConsentChanger")
  createdCustomerNotes       CustomerNote[]             @relation("CreatedCustomerNotes")
  updatedCustomerNotes       CustomerNote[]             @relation("UpdatedCustomerNotes")
  createdCustomerTags        CustomerTag[]              @relation("CreatedCustomerTags")
  updatedCustomerTags        CustomerTag[]              @relation("UpdatedCustomerTags")
  assignedTagAssignments     CustomerTagAssignment[]    @relation("TagAssigner")
  createdLoyaltyTiers        LoyaltyTierDefinition[]    @relation("CreatedLoyaltyTiers")
  updatedLoyaltyTiers        LoyaltyTierDefinition[]    @relation("UpdatedLoyaltyTiers")
  createdLoyaltyLedgers      LoyaltyLedger[]            @relation("CreatedLoyaltyLedgers")
  createdMembershipPlans     MembershipPlan[]           @relation("CreatedMembershipPlans")
  updatedMembershipPlans     MembershipPlan[]           @relation("UpdatedMembershipPlans")
  createdCustomerMemberships CustomerMembership[]       @relation("CreatedCustomerMemberships")
  updatedCustomerMemberships CustomerMembership[]       @relation("UpdatedCustomerMemberships")
  createdWalletLedgers       CustomerWalletLedger[]     @relation("CreatedWalletLedgers")
  createdCustomerReferrals   CustomerReferral[]         @relation("CreatedCustomerReferrals")
  updatedCustomerReferrals   CustomerReferral[]         @relation("UpdatedCustomerReferrals")
  mergedCustomerHistories    CustomerMergeHistory[]     @relation("CustomerMerger")

  // Phase 16 Inventory Relations
  approvedPurchaseOrders      PurchaseOrder[]            @relation("ApprovedPurchaseOrders")
  receivedGRNs                GoodsReceivedNote[]        @relation("ReceivedGRNs")
  dispatchedStockTransfers    StockTransfer[]            @relation("DispatchedStockTransfers")
  receivedStockTransfers      StockTransfer[]            @relation("ReceivedStockTransfers")
  requestedStockAdjustments   StockAdjustment[]          @relation("RequestedStockAdjustments")
  approvedStockAdjustments    StockAdjustment[]          @relation("ApprovedStockAdjustments")
  conductedStockAudits        StockAudit[]               @relation("ConductedStockAudits")
  approvedStockAudits         StockAudit[]               @relation("ApprovedStockAudits")
  acknowledgedLowStockAlerts  LowStockAlert[]            @relation("AcknowledgedLowStockAlerts")
  stockMovements              StockMovement[]            @relation("ActorStockMovements")
  usedProducts                ProductUsage[]             @relation("UsedByStaffUser")

  // Phase 17 Reviews & Feedback Relations
  customerReviews             Review[]                   @relation("CustomerReviews")
  userHelpfulVotes            ReviewHelpfulVote[]        @relation("UserHelpfulVotes")
  reportedReviewFlags         ReviewFlag[]               @relation("ReportedReviewFlags")
  resolvedReviewFlags         ReviewFlag[]               @relation("ResolvedReviewFlags")
  submittedReviewDisputes     ReviewDispute[]            @relation("SubmittedReviewDisputes")
  reviewedReviewDisputes      ReviewDispute[]            @relation("ReviewedReviewDisputes")
  responderUserReplies        ReviewReply[]              @relation("ResponderUserReplies")
  customerReviewInvitations   ReviewInvitation[]         @relation("CustomerReviewInvitations")

  // Phase 18 Promotions, Gift Cards & Marketing Relations
  targetedCoupons             CouponCustomerEligibility[] @relation("TargetedCustomerCoupons")
  couponUsages                CouponUsage[]               @relation("CustomerCouponUsages")
  purchasedGiftCards          GiftCard[]                  @relation("PurchasedGiftCards")
  performedGiftCardTransactions GiftCardTransaction[]     @relation("PerformedGiftCardTransactions")

  // Phase 19 Notifications Relations
  notificationPreferences    UserNotificationPreference[] @relation("UserNotificationPreferences")

  // Phase 20 File & Media Storage Relations
  uploadedFileAssets         FileAsset[]                @relation("UserUploadedFileAssets")


  @@index([deletedAt, role, isActive], map: "idx_users_admin_filter")
  @@index([createdAt(sort: Desc)], map: "idx_users_created_at")
  @@index([deletedAt], map: "idx_users_deleted_at")
  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash")
  deviceId         String   @map("device_id")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_sessions_user")

  @@index([userId, refreshTokenHash], map: "idx_user_sessions_lookup")
  @@map("user_sessions")
}

model Salon {
  id               String        @id @default(uuid()) @db.Uuid
  ownerId          String        @map("owner_id") @db.Uuid
  brandName        String        @map("brand_name")
  slug             String?       @unique(map: "uq_salons_slug")
  description      String?
  gstin            String?
  planType         SalonPlanType @default(FREE_COMMISSION) @map("plan_type")
  status           SalonStatus   @default(PENDING_APPROVAL)
  logoMediaId      String?       @map("logo_media_id") @db.Uuid
  
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz
  createdById      String?       @map("created_by_id") @db.Uuid
  updatedById      String?       @map("updated_by_id") @db.Uuid
  version          Int           @default(1)

  owner            User          @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Restrict, map: "fk_salons_owner")
  logoMedia        Media?        @relation("SalonLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull, map: "fk_salons_logo_media")
  branches         Branch[]
  staff            Staff[]
  bookings         Booking[]
  payments         Payment[]                  @relation("SalonPayments")
  invoices         Invoice[]                  @relation("SalonInvoices")
  customerProfiles CustomerProfile[]          @relation("SalonCustomerProfiles")
  customerTags     CustomerTag[]              @relation("SalonCustomerTags")
  loyaltyTiers     LoyaltyTierDefinition[]    @relation("SalonLoyaltyTiers")
  membershipPlans  MembershipPlan[]           @relation("SalonMembershipPlans")

  // Phase 16 Inventory Relations
  products           Product[]                  @relation("SalonProducts")
  productCategories  ProductCategory[]          @relation("SalonProductCategories")
  brands             Brand[]                    @relation("SalonBrands")
  unitsOfMeasure     UnitOfMeasure[]            @relation("SalonUnitsOfMeasure")
  suppliers          Supplier[]                 @relation("SalonSuppliers")

  // Phase 17 Reviews & Feedback Relations
  reviews                Review[]                   @relation("SalonReviews")
  reviewReplies          ReviewReply[]              @relation("SalonReviewReplies")
  reviewDisputes         ReviewDispute[]            @relation("SalonReviewDisputes")
  ratingSummary          SalonRatingSummary?
  staffRatingSummaries   StaffRatingSummary[]       @relation("SalonStaffRatingSummaries")
  serviceRatingSummaries ServiceRatingSummary[]     @relation("SalonServiceRatingSummaries")
  reviewInvitations      ReviewInvitation[]         @relation("SalonReviewInvitations")

  // Phase 18 Promotions, Gift Cards & Marketing Relations
  coupons                Coupon[]                   @relation("SalonCoupons")
  couponUsages           CouponUsage[]              @relation("SalonCouponUsages")
  giftCards              GiftCard[]                 @relation("SalonGiftCards")
  flashSales             FlashSale[]                @relation("SalonFlashSales")
  marketingCampaigns     MarketingCampaign[]        @relation("SalonMarketingCampaigns")

  // Phase 19 Notifications & Communication Relations
  notificationTemplates  NotificationTemplate[]     @relation("SalonNotificationTemplates")
  notifications          Notification[]             @relation("SalonNotifications")

  // Phase 20 File & Media Storage Relations
  fileAssets             FileAsset[]                @relation("SalonFileAssets")

  @@index([ownerId], map: "idx_salons_owner")
  @@index([deletedAt, status], map: "idx_salons_status_filter")
  @@index([planType, status], map: "idx_salons_plan_status")
  @@map("salons")
}

model Branch {
  id               String               @id @default(uuid()) @db.Uuid
  salonId          String               @map("salon_id") @db.Uuid
  managerStaffId   String?              @map("manager_staff_id") @db.Uuid
  branchName       String               @map("branch_name")
  isPrimary        Boolean              @default(false) @map("is_primary")
  addressLine1     String               @map("address_line1")
  addressLine2     String?              @map("address_line2")
  city             String
  state            String
  pincode          String
  latitude         Float
  longitude        Float
  phone            String
  genderCategory   BranchGenderCategory @default(UNISEX) @map("gender_category")
  coverMediaId     String?              @map("cover_media_id") @db.Uuid
  status           SalonStatus          @default(APPROVED)

  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz
  createdById      String?              @map("created_by_id") @db.Uuid
  updatedById      String?              @map("updated_by_id") @db.Uuid
  version          Int                  @default(1)

  salon            Salon                @relation(fields: [salonId], references: [id], onDelete: Restrict, map: "fk_branches_salon")
  managerStaff     Staff?               @relation("BranchManagerStaff", fields: [managerStaffId], references: [id], onDelete: SetNull, map: "fk_branches_manager_staff")
  coverMedia       Media?               @relation("BranchCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull, map: "fk_branches_cover_media")
  businessHours    BranchBusinessHours[]
  specialHolidays  BranchSpecialHoliday[]
  tempClosures     BranchTempClosure[]
  staffAssignments StaffBranchAssignment[]
  workingHours     StaffWorkingHours[]
  services         BranchService[]
  appointments     Appointment[]
  bookings         Booking[]
  reservationLocks BookingReservationLock[]
  payments                Payment[]                  @relation("BranchPayments")
  invoices                Invoice[]                  @relation("BranchInvoices")
  primaryCustomerProfiles CustomerProfile[]          @relation("PrimaryBranchCustomerProfiles")
  customerNotes           CustomerNote[]             @relation("BranchCustomerNotes")
  customerVisitHistories  CustomerVisitHistory[]     @relation("BranchCustomerVisits")

  // Phase 16 Inventory Relations
  inventoryStocks              InventoryStock[]           @relation("BranchInventoryStocks")
  purchaseOrders               PurchaseOrder[]            @relation("BranchPurchaseOrders")
  goodsReceivedNotes           GoodsReceivedNote[]        @relation("BranchGoodsReceivedNotes")
  stockMovements               StockMovement[]            @relation("BranchStockMovements")
  sourceStockTransfers         StockTransfer[]            @relation("SourceBranchStockTransfers")
  destinationStockTransfers    StockTransfer[]            @relation("DestinationBranchStockTransfers")
  stockAdjustments             StockAdjustment[]          @relation("BranchStockAdjustments")
  stockAudits                  StockAudit[]               @relation("BranchStockAudits")
  lowStockAlerts               LowStockAlert[]            @relation("BranchLowStockAlerts")
  productUsages                ProductUsage[]             @relation("BranchProductUsages")

  // Phase 17 Reviews & Feedback Relations
  reviews                      Review[]                   @relation("BranchReviews")
  ratingSummary                BranchRatingSummary?
  reviewInvitations            ReviewInvitation[]         @relation("BranchReviewInvitations")

  // Phase 18 Promotions, Gift Cards & Marketing Relations
  branchCouponApplicabilities  CouponBranchApplicability[] @relation("BranchCouponApplicabilities")
  couponUsages                 CouponUsage[]               @relation("BranchCouponUsages")
  flashSales                   FlashSale[]                 @relation("BranchFlashSales")

  @@index([salonId, isPrimary], map: "idx_branches_salon_primary")
  @@index([deletedAt, status], map: "idx_branches_status_filter")
  @@index([city], map: "idx_branches_city")
  @@index([genderCategory], map: "idx_branches_gender_category")
  @@map("branches")
}

model BranchBusinessHours {
  branchId         String         @map("branch_id") @db.Uuid
  dayOfWeek        ShiftDayOfWeek @map("day_of_week")
  openTime         DateTime       @map("open_time") @db.Time
  closeTime        DateTime       @map("close_time") @db.Time
  isClosed         Boolean        @default(false) @map("is_closed")

  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "fk_branch_business_hours_branch")

  @@id([branchId, dayOfWeek], map: "pk_branch_business_hours")
  @@map("branch_business_hours")
}

model BranchSpecialHoliday {
  id               String    @id @default(uuid()) @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  holidayDate      DateTime  @map("holiday_date") @db.Date
  reason           String
  isFullDay        Boolean   @default(true) @map("is_full_day")

  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "fk_branch_special_holidays_branch")

  @@index([branchId, holidayDate], map: "idx_branch_holidays_date")
  @@map("branch_special_holidays")
}

model BranchTempClosure {
  id               String    @id @default(uuid()) @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  startTime        DateTime  @map("start_time") @db.Timestamptz
  endTime          DateTime  @map("end_time") @db.Timestamptz
  reason           String

  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "fk_branch_temp_closures_branch")

  @@index([branchId, startTime], map: "idx_branch_closures_time")
