}

model CouponCustomerEligibility {
  id               String       @id @default(uuid()) @db.Uuid
  couponId         String       @map("coupon_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz

  coupon           Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "fk_coupon_cust_elig_coupon")
  customer         User         @relation("TargetedCustomerCoupons", fields: [customerId], references: [id], onDelete: Cascade, map: "fk_coupon_cust_elig_customer")

  @@unique([couponId, customerId], map: "uq_coupon_cust_elig_coupon_cust")
  @@index([couponId], map: "idx_coupon_cust_elig_coupon")
  @@index([customerId], map: "idx_coupon_cust_elig_customer")
  @@map("coupon_customer_eligibilities")
