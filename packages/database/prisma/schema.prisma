  professionalPrice    Int                  @default(0) @map("professional_price")
  minStockLevel        Int                  @default(5) @map("min_stock_level")
  reorderPoint         Int                  @default(10) @map("reorder_point")
  reorderQuantity      Int                  @default(20) @map("reorder_quantity")
  weightGrams          Int?                 @map("weight_grams")
  volumeMl             Int?                 @map("volume_ml")
  isActive             Boolean              @default(true) @map("is_active")
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz
