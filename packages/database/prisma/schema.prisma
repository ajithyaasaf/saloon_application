enum ProductType {
  RETAIL
  PROFESSIONAL
  CONSUMABLE

  @@map("enum_product_type")
}

enum InventoryStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRED
  LOCKED

  @@map("enum_inventory_status")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL_RECEIVED
  FULLY_RECEIVED
  CANCELLED
  REJECTED

  @@map("enum_purchase_order_status")
}

enum GRNStatus {
  DRAFT
  RECEIVED
  VERIFIED
  REJECTED

  @@map("enum_grn_status")
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  SERVICE_CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  AUDIT_CORRECTION
  DAMAGE_WRITE_OFF
  EXPIRY_WRITE_OFF
  INTERNAL_USE
  RETURN_TO_SUPPLIER

  @@map("enum_stock_movement_type")
}

enum TransferStatus {
  DRAFT
  PENDING_DISPATCH
  DISPATCHED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CANCELLED

  @@map("enum_transfer_status")
}

enum AdjustmentReason {
  DAMAGE
  SHRINKAGE_THEFT
  EXPIRY
  AUDIT_DISCREPANCY
  DATA_ENTRY_ERROR
  INTERNAL_SAMPLE
  OTHER

  @@map("enum_adjustment_reason")
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED

  @@map("enum_audit_status")
}

enum ProductUsageType {
  SERVICE_CONSUMPTION
  RETAIL_SALE
  MANUAL_INTERNAL
  TESTER_SAMPLE
  WASTE
  DAMAGE

  @@map("enum_product_usage_type")
}

enum UnitType {
  VOLUME
  WEIGHT
  COUNT

  @@map("enum_unit_type")
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED

  @@map("enum_alert_status")
}

model ProductCategory {
  id               String            @id @default(uuid()) @db.Uuid
  salonId          String            @map("salon_id") @db.Uuid
  parentCategoryId String?           @map("parent_category_id") @db.Uuid
  name             String
  slug             String
  description      String?
  isActive         Boolean           @default(true) @map("is_active")
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz

  salon            Salon             @relation("SalonProductCategories", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_product_categories_salon")
  parentCategory   ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull, map: "fk_product_categories_parent")
  subCategories    ProductCategory[] @relation("CategoryHierarchy")
  products         Product[]

  @@unique([salonId, slug], map: "uq_product_categories_salon_slug")
  @@index([salonId, isActive], map: "idx_product_categories_salon")
  @@map("product_categories")
}

model Brand {
  id               String            @id @default(uuid()) @db.Uuid
  salonId          String            @map("salon_id") @db.Uuid
  name             String
  logoUrl          String?           @map("logo_url")
  website          String?
  isActive         Boolean           @default(true) @map("is_active")
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz

  salon            Salon             @relation("SalonBrands", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_brands_salon")
  products         Product[]

  @@index([salonId, isActive], map: "idx_brands_salon")
  @@map("brands")
}

model UnitOfMeasure {
  id               String            @id @default(uuid()) @db.Uuid
  salonId          String            @map("salon_id") @db.Uuid
  name             String
  code             String            @db.VarChar(16)
  unitType         UnitType          @map("unit_type")
  conversionFactor Float             @default(1.0) @map("conversion_factor")
  baseUnitId       String?           @map("base_unit_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  salon            Salon             @relation("SalonUnitsOfMeasure", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_units_of_measure_salon")
  baseUnit         UnitOfMeasure?    @relation("UOMHierarchy", fields: [baseUnitId], references: [id], onDelete: SetNull, map: "fk_units_of_measure_base")
  derivedUnits     UnitOfMeasure[]   @relation("UOMHierarchy")
  products         Product[]

  @@unique([salonId, code], map: "uq_units_of_measure_salon_code")
  @@map("units_of_measure")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  salonId          String            @map("salon_id") @db.Uuid
  brandId          String?           @map("brand_id") @db.Uuid
  categoryId       String            @map("category_id") @db.Uuid
  uomId            String            @map("uom_id") @db.Uuid
  name             String
  slug             String
  description      String?
  productType      ProductType       @default(RETAIL) @map("product_type")
  isActive         Boolean           @default(true) @map("is_active")
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz

  salon            Salon             @relation("SalonProducts", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_products_salon")
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull, map: "fk_products_brand")
  category         ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_products_category")
  uom              UnitOfMeasure     @relation(fields: [uomId], references: [id], onDelete: Restrict, map: "fk_products_uom")
  variants         ProductVariant[]

  @@unique([salonId, slug], map: "uq_products_salon_slug")
  @@index([salonId, productType, isActive], map: "idx_products_salon_type")
  @@map("products")
}

model ProductVariant {
  id                   String               @id @default(uuid()) @db.Uuid
  productId            String               @map("product_id") @db.Uuid
  sku                  String               @db.VarChar(64)
