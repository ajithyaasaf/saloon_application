model CouponUsage {
  id                           String            @id @default(uuid()) @db.Uuid
  couponId                     String            @map("coupon_id") @db.Uuid
  salonId                      String            @map("salon_id") @db.Uuid
  branchId                     String            @map("branch_id") @db.Uuid
  customerId                   String            @map("customer_id") @db.Uuid
  bookingId                    String?           @map("booking_id") @db.Uuid
  appointmentId                String?           @unique(map: "uq_coupon_usages_appointment") @map("appointment_id") @db.Uuid
  invoiceId                    String?           @map("invoice_id") @db.Uuid
  discountAmount               Int               @map("discount_amount")
  bookingTotalBeforeDiscount   Int               @map("booking_total_before_discount")
  bookingTotalAfterDiscount    Int               @map("booking_total_after_discount")
  status                       CouponUsageStatus @default(APPLIED)
  appliedAt                    DateTime          @default(now()) @map("applied_at") @db.Timestamptz
  settledAt                    DateTime?         @map("settled_at") @db.Timestamptz
  reversedAt                   DateTime?         @map("reversed_at") @db.Timestamptz
  reversalReason               String?           @map("reversal_reason")
  createdAt                    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  coupon                       Coupon            @relation(fields: [couponId], references: [id], onDelete: Restrict, map: "fk_coupon_usages_coupon")
  salon                        Salon             @relation("SalonCouponUsages", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_coupon_usages_salon")
  branch                       Branch            @relation("BranchCouponUsages", fields: [branchId], references: [id], onDelete: Restrict, map: "fk_coupon_usages_branch")
  customer                     User              @relation("CustomerCouponUsages", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_coupon_usages_customer")
  booking                      Booking?          @relation("BookingCouponUsages", fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_coupon_usages_booking")
  appointment                  Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull, map: "fk_coupon_usages_appointment")
  invoice                      Invoice?          @relation("InvoiceCouponUsages", fields: [invoiceId], references: [id], onDelete: SetNull, map: "fk_coupon_usages_invoice")

  @@index([couponId, customerId], map: "idx_coupon_usages_coupon_cust")
  @@index([salonId, status], map: "idx_coupon_usages_salon_status")
  @@index([branchId], map: "idx_coupon_usages_branch")
  @@index([customerId], map: "idx_coupon_usages_customer")
  @@index([bookingId], map: "idx_coupon_usages_booking")
  @@map("coupon_usages")
}

model GiftCard {
  id                 String                  @id @default(uuid()) @db.Uuid
  giftCardCode       String                  @unique(map: "uq_gift_cards_code") @map("gift_card_code") @db.VarChar(32)
  salonId            String                  @map("salon_id") @db.Uuid
  purchasedByUserId  String?                 @map("purchased_by_user_id") @db.Uuid
  recipientName      String?                 @map("recipient_name") @db.VarChar(100)
  recipientEmail     String?                 @map("recipient_email") @db.VarChar(255)
  recipientPhone     String?                 @map("recipient_phone") @db.VarChar(20)
  personalMessage    String?                 @map("personal_message")
  initialBalance     Int                     @map("initial_balance")
  currentBalance     Int                     @map("current_balance")
  currency           String                  @default("INR") @db.VarChar(3)
  status             GiftCardStatus          @default(ACTIVE)
  expiresAt          DateTime                @map("expires_at") @db.Timestamptz
  version            Int                     @default(1)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?               @map("deleted_at") @db.Timestamptz

  salon              Salon                   @relation("SalonGiftCards", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_gift_cards_salon")
  purchasedByUser    User?                   @relation("PurchasedGiftCards", fields: [purchasedByUserId], references: [id], onDelete: SetNull, map: "fk_gift_cards_purchased_user")
  transactions       GiftCardTransaction[]

  @@index([salonId, status], map: "idx_gift_cards_salon_status")
  @@index([purchasedByUserId], map: "idx_gift_cards_purchased_user")
  @@index([recipientEmail], map: "idx_gift_cards_recipient_email")
  @@index([recipientPhone], map: "idx_gift_cards_recipient_phone")
  @@index([deletedAt], map: "idx_gift_cards_deleted_at")
  @@map("gift_cards")
}

model GiftCardTransaction {
  id                 String                  @id @default(uuid()) @db.Uuid
  giftCardId         String                  @map("gift_card_id") @db.Uuid
  bookingId          String?                 @map("booking_id") @db.Uuid
  invoiceId          String?                 @map("invoice_id") @db.Uuid
  transactionType    GiftCardTransactionType @map("transaction_type")
  amount             Int
  balanceBefore      Int                     @map("balance_before")
  balanceAfter       Int                     @map("balance_after")
  notes              String?
  performedByUserId  String?                 @map("performed_by_user_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz

  giftCard           GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade, map: "fk_gift_card_txs_card")
  booking            Booking?                @relation("BookingGiftCardTransactions", fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_gift_card_txs_booking")
  invoice            Invoice?                @relation("InvoiceGiftCardTransactions", fields: [invoiceId], references: [id], onDelete: SetNull, map: "fk_gift_card_txs_invoice")
  performedByUser    User?                   @relation("PerformedGiftCardTransactions", fields: [performedByUserId], references: [id], onDelete: SetNull, map: "fk_gift_card_txs_user")

  @@index([giftCardId, createdAt(sort: Desc)], map: "idx_gift_card_txs_card_date")
  @@index([bookingId], map: "idx_gift_card_txs_booking")
  @@map("gift_card_transactions")
}

model FlashSale {
  id                 String               @id @default(uuid()) @db.Uuid
  salonId            String               @map("salon_id") @db.Uuid
  branchId           String               @map("branch_id") @db.Uuid
  serviceId          String               @map("service_id") @db.Uuid
  title              String               @db.VarChar(100)
  discountPercentage Decimal              @map("discount_percentage") @db.Decimal(5, 2)
  specialPrice       Int                  @map("special_price")
  startTime          DateTime             @map("start_time") @db.Timestamptz
  endTime            DateTime             @map("end_time") @db.Timestamptz
  maxSlotQuota       Int                  @map("max_slot_quota")
  bookedSlotCount    Int                  @default(0) @map("booked_slot_count")
  status             FlashSaleStatus      @default(SCHEDULED)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz

  salon              Salon                @relation("SalonFlashSales", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_flash_sales_salon")
  branch             Branch               @relation("BranchFlashSales", fields: [branchId], references: [id], onDelete: Restrict, map: "fk_flash_sales_branch")
  service            Service              @relation("ServiceFlashSales", fields: [serviceId], references: [id], onDelete: Restrict, map: "fk_flash_sales_service")

  @@index([salonId, branchId, status], map: "idx_flash_sales_lookup")
  @@index([startTime, endTime, status], map: "idx_flash_sales_time_window")
  @@index([serviceId], map: "idx_flash_sales_service")
  @@index([deletedAt], map: "idx_flash_sales_deleted_at")
  @@map("flash_sales")
}

model MarketingCampaign {
  id                     String                  @id @default(uuid()) @db.Uuid
  campaignCode           String                  @unique(map: "uq_marketing_campaigns_code") @map("campaign_code") @db.VarChar(32)
  salonId                String                  @map("salon_id") @db.Uuid
  name                   String                  @db.VarChar(150)
  description            String?
  campaignType           MarketingCampaignType   @default(SEASONAL) @map("campaign_type")
  couponId               String?                 @map("coupon_id") @db.Uuid
  targetAudienceSegment  String                  @default("ALL") @map("target_audience_segment") @db.VarChar(50)
  channels               String[]                @default([])
  budgetLimit            Int                     @default(0) @map("budget_limit")
  actualSpend            Int                     @default(0) @map("actual_spend")
  status                 MarketingCampaignStatus @default(DRAFT)
  scheduledStartAt       DateTime?               @map("scheduled_start_at") @db.Timestamptz
  scheduledEndAt         DateTime?               @map("scheduled_end_at") @db.Timestamptz
  impressionsCount       Int                     @default(0) @map("impressions_count")
  clicksCount            Int                     @default(0) @map("clicks_count")
  bookingsCount          Int                     @default(0) @map("bookings_count")
  revenueGenerated       Int                     @default(0) @map("revenue_generated")
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz

  salon                  Salon                   @relation("SalonMarketingCampaigns", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_marketing_campaigns_salon")
  coupon                 Coupon?                 @relation(fields: [couponId], references: [id], onDelete: SetNull, map: "fk_marketing_campaigns_coupon")

  @@index([salonId, status], map: "idx_marketing_campaigns_salon_status")
  @@index([campaignType], map: "idx_marketing_campaigns_type")
  @@index([scheduledStartAt, scheduledEndAt], map: "idx_marketing_campaigns_schedule")
  @@index([deletedAt], map: "idx_marketing_campaigns_deleted_at")
  @@map("marketing_campaigns")
}

