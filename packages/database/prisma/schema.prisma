  sentAt             DateTime?           @map("sent_at") @db.Timestamptz
  deliveredAt        DateTime?           @map("delivered_at") @db.Timestamptz
  readAt             DateTime?           @map("read_at") @db.Timestamptz
  failedReason       String?             @map("failed_reason") @db.Text
  externalMetadata   Json?               @map("external_metadata")
  retryCount         Int                 @default(0) @map("retry_count")
  nextRetryAt        DateTime?           @map("next_retry_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  notification       Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade, map: "fk_notification_deliveries_notification")

  @@index([notificationId], map: "idx_notification_deliveries_notification")
  @@index([status, nextRetryAt], map: "idx_notification_deliveries_retry")
  @@index([channel, status], map: "idx_notification_deliveries_channel_status")
  @@map("notification_deliveries")
}

