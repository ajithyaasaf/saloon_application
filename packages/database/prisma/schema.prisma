model CustomerProfile {
  id                   String                  @id @default(uuid()) @db.Uuid
  customerCode         String                  @unique(map: "uq_customer_profiles_code") @map("customer_code") @db.VarChar(32)
  userId               String?                 @map("user_id") @db.Uuid
  salonId              String                  @map("salon_id") @db.Uuid
  primaryBranchId      String                  @map("primary_branch_id") @db.Uuid
  firstName            String                  @map("first_name")
  lastName             String?                 @map("last_name")
  email                String?
  phone                String
  gender               Gender?
  birthDate            DateTime?               @map("birth_date") @db.Date
  anniversaryDate      DateTime?               @map("anniversary_date") @db.Date
  status               CustomerStatus          @default(ACTIVE)
  walletBalance        Int                     @default(0) @map("wallet_balance")
  lifetimeSpend        Int                     @default(0) @map("lifetime_spend")
  totalVisits          Int                     @default(0) @map("total_visits")
  noShowCount          Int                     @default(0) @map("no_show_count")
  cancellationCount    Int                     @default(0) @map("cancellation_count")
  lastVisitAt          DateTime?               @map("last_visit_at") @db.Timestamptz
  isBlacklisted        Boolean                 @default(false) @map("is_blacklisted")
  blacklistType        BlacklistType?          @map("blacklist_type")
  blacklistReason      String?                 @map("blacklist_reason")
  blacklistedAt        DateTime?               @map("blacklisted_at") @db.Timestamptz
  blacklistedByUserId  String?                 @map("blacklisted_by_user_id") @db.Uuid
  version              Int                     @default(1)
  createdByUserId      String                  @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?                 @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz

  user                 User?                   @relation("CustomerUser", fields: [userId], references: [id], onDelete: SetNull, map: "fk_customer_profiles_user")
  salon                Salon                   @relation("SalonCustomerProfiles", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_customer_profiles_salon")
  primaryBranch        Branch                  @relation("PrimaryBranchCustomerProfiles", fields: [primaryBranchId], references: [id], onDelete: Restrict, map: "fk_customer_profiles_branch")
  blacklistedByUser    User?                   @relation("BlacklistedByUser", fields: [blacklistedByUserId], references: [id], onDelete: SetNull, map: "fk_customer_profiles_blacklisted_by_user")
  createdByUser        User                    @relation("CreatedCustomerProfiles", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_customer_profiles_created_by_user")
  updatedByUser        User?                   @relation("UpdatedCustomerProfiles", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_customer_profiles_updated_by_user")

  preference           CustomerPreference?
  consentHistories     CustomerConsentHistory[]
  notes                CustomerNote[]
  tagAssignments       CustomerTagAssignment[]
  loyalty              CustomerLoyalty?
  loyaltyLedgers       LoyaltyLedger[]
  memberships          CustomerMembership[]
  walletLedgers        CustomerWalletLedger[]
  referredReferrals    CustomerReferral[]      @relation("ReferredCustomerProfile")
  createdReferrals     CustomerReferral[]      @relation("ReferrerCustomerProfile")
  referralRewards      ReferralReward[]
  visitHistories       CustomerVisitHistory[]
  mergeHistoriesTarget CustomerMergeHistory[]   @relation("TargetCustomerProfile")

  @@unique([salonId, phone], map: "uq_customer_profiles_salon_phone")
  @@index([salonId, deletedAt], map: "idx_customer_profiles_salon")
  @@index([primaryBranchId], map: "idx_customer_profiles_primary_branch")
  @@index([userId], map: "idx_customer_profiles_user")
  @@index([phone], map: "idx_customer_profiles_phone")
  @@index([email], map: "idx_customer_profiles_email")
  @@index([status], map: "idx_customer_profiles_status")
  @@index([isBlacklisted], map: "idx_customer_profiles_blacklisted")
  @@index([lifetimeSpend(sort: Desc)], map: "idx_customer_profiles_spend")
  @@index([lastVisitAt(sort: Desc)], map: "idx_customer_profiles_last_visit")
  @@index([createdAt(sort: Desc)], map: "idx_customer_profiles_created_at")
  @@index([deletedAt], map: "idx_customer_profiles_deleted_at")
  @@map("customer_profiles")
}

