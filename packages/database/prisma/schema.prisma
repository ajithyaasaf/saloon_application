  minServicesCount           Int                           @default(1) @map("min_services_count")
  applicabilityType          CouponApplicabilityType       @default(ALL_SERVICES) @map("applicability_type")
  customerEligibility        CouponCustomerEligibilityType @default(ALL_CUSTOMERS) @map("customer_eligibility")
  totalUsageLimit            Int?                          @map("total_usage_limit")
  perCustomerLimit           Int                           @default(1) @map("per_customer_limit")
  currentUsageCount          Int                           @default(0) @map("current_usage_count")
  isAutoApply                Boolean                       @default(false) @map("is_auto_apply")
  isCombinableWithOtherOffers Boolean                      @default(false) @map("is_combinable_with_other_offers")
  isHappyHour                Boolean                       @default(false) @map("is_happy_hour")
  validDaysOfWeek            Int[]                         @default([]) @map("valid_days_of_week")
  validStartTime             String?                       @map("valid_start_time") @db.VarChar(8)
  validEndTime               String?                       @map("valid_end_time") @db.VarChar(8)
  startDate                  DateTime                      @map("start_date") @db.Timestamptz
  endDate                    DateTime                      @map("end_date") @db.Timestamptz
  status                     CouponStatus                  @default(DRAFT)
  version                    Int                           @default(1)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                  DateTime?                     @map("deleted_at") @db.Timestamptz

  salon                      Salon?                        @relation("SalonCoupons", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_coupons_salon")
  serviceApplicabilities     CouponServiceApplicability[]
  categoryApplicabilities    CouponCategoryApplicability[]
  branchApplicabilities      CouponBranchApplicability[]
  customerEligibilities      CouponCustomerEligibility[]
  usages                     CouponUsage[]
  appliedBookings            Booking[]                     @relation("BookingAppliedCoupon")
  marketingCampaigns         MarketingCampaign[]

  @@unique([salonId, code], map: "uq_coupons_salon_code")
  @@index([code], map: "idx_coupons_code")
  @@index([salonId, status], map: "idx_coupons_salon_status")
  @@index([status, startDate, endDate], map: "idx_coupons_active_window")
  @@index([deletedAt], map: "idx_coupons_deleted_at")
  @@map("coupons")
}

model CouponServiceApplicability {
