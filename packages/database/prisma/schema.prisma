  branch           Branch       @relation("BranchCouponApplicabilities", fields: [branchId], references: [id], onDelete: Cascade, map: "fk_coupon_branch_apps_branch")

  @@unique([couponId, branchId], map: "uq_coupon_branch_apps_coupon_branch")
  @@index([couponId], map: "idx_coupon_branch_apps_coupon")
  @@index([branchId], map: "idx_coupon_branch_apps_branch")
