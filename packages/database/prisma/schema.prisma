model FileAsset {
  id               String          @id @default(uuid()) @db.Uuid
  salonId          String?         @map("salon_id") @db.Uuid
  uploadedByUserId String          @map("uploaded_by_user_id") @db.Uuid
  originalFileName String          @map("original_file_name")
  storedFileName   String          @map("stored_file_name")
  objectKey        String          @unique(map: "uq_file_assets_object_key") @map("object_key")
  bucket           String          @map("bucket")
  provider         String          @default("R2") @map("provider") @db.VarChar(50)
  mimeType         String          @map("mime_type") @db.VarChar(100)
  extension        String          @map("extension") @db.VarChar(20)
  sizeBytes        Int             @map("size_bytes")
  checksum         String?         @map("checksum") @db.VarChar(128)
  status           FileStatus      @default(UPLOADING) @map("status")
  visibility       FileVisibility  @default(PRIVATE) @map("visibility")
  category         FileCategory    @default(OTHER) @map("category")
  width            Int?            @map("width")
  height           Int?            @map("height")
  duration         Int?            @map("duration")
  metadata         Json?           @map("metadata")
  altText          String?         @map("alt_text")
  folder           String?         @map("folder")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz

  salon            Salon?          @relation("SalonFileAssets", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_file_assets_salon")
  uploadedByUser   User            @relation("UserUploadedFileAssets", fields: [uploadedByUserId], references: [id], onDelete: Restrict, map: "fk_file_assets_uploader")

  @@index([salonId], map: "idx_file_assets_salon_id")
  @@index([uploadedByUserId], map: "idx_file_assets_uploaded_by_user_id")
  @@index([status], map: "idx_file_assets_status")
  @@index([category], map: "idx_file_assets_category")
  @@index([visibility], map: "idx_file_assets_visibility")
  @@index([createdAt(sort: Desc)], map: "idx_file_assets_created_at")
  @@index([deletedAt], map: "idx_file_assets_deleted_at")
  @@index([salonId, category], map: "idx_file_assets_salon_category")
  @@index([salonId, status], map: "idx_file_assets_salon_status")
  @@map("file_assets")
}



