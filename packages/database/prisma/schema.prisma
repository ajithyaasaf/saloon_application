// ==========================================
// BOOKING ENGINE DOMAIN (PHASE 13)
// ==========================================

model Booking {
  id                   String                 @id @default(uuid()) @db.Uuid
  bookingCode          String                 @unique(map: "uq_bookings_code") @map("booking_code") @db.VarChar(32)
  sequenceNumber       BigInt                 @map("sequence_number")
  salonId              String                 @map("salon_id") @db.Uuid
  branchId             String                 @map("branch_id") @db.Uuid
  customerId           String                 @map("customer_id") @db.Uuid
  walkInType           WalkInType             @default(NONE) @map("walk_in_type")
  isWalkIn             Boolean                @default(false) @map("is_walk_in")
  status               BookingStatus          @default(PENDING)
  paymentStatus        PaymentStatus          @default(UNPAID) @map("payment_status")
  cancellationReason   String?                @map("cancellation_reason")
  cancelledByUserId    String?                @map("cancelled_by_user_id") @db.Uuid
  cancelledAt          DateTime?              @map("cancelled_at") @db.Timestamptz
  rescheduleCount      Int                    @default(0) @map("reschedule_count")
  bookingDate          DateTime               @map("booking_date") @db.Date
  startTime            DateTime               @map("start_time") @db.Timestamptz
  endTime              DateTime               @map("end_time") @db.Timestamptz
  totalDurationMinutes Int                    @map("total_duration_minutes")
  subtotalAmount       Int                    @default(0) @map("subtotal_amount")
  taxAmount            Int                    @default(0) @map("tax_amount")
  discountAmount       Int                    @default(0) @map("discount_amount")
  totalAmount          Int                    @default(0) @map("total_amount")
  currency             String                 @default("INR") @db.VarChar(3)
  paymentId            String?                @map("payment_id") @db.Uuid
  couponId             String?                @map("coupon_id") @db.Uuid
  reviewId             String?                @map("review_id") @db.Uuid
  notes                String?
  internalNotes        String?                @map("internal_notes")
  clientIp             String?                @map("client_ip") @db.VarChar(45)
  userAgent            String?                @map("user_agent")
  version              Int                    @default(1)
  createdByUserId      String                 @map("created_by_user_id") @db.Uuid
  updatedByUserId      String?                @map("updated_by_user_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz

  salon                Salon                  @relation(fields: [salonId], references: [id], onDelete: Restrict, map: "fk_bookings_salon")
  branch               Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_bookings_branch")
  customer             User                   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_bookings_customer")
  cancelledByUser      User?                  @relation("CancelledBookings", fields: [cancelledByUserId], references: [id], onDelete: SetNull, map: "fk_bookings_cancelled_by_user")
  createdByUser        User                   @relation("CreatedBookings", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_bookings_created_by_user")
  updatedByUser        User?                  @relation("UpdatedBookings", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_bookings_updated_by_user")

  items                BookingItem[]
  statusHistories      BookingStatusHistory[]
  reservationLocks     BookingReservationLock[]
  payments             Payment[]                  @relation("BookingPayments")
  refunds              Refund[]                   @relation("BookingRefunds")
  invoices             Invoice[]                  @relation("BookingInvoices")
  customerVisitHistories CustomerVisitHistory[]   @relation("BookingCustomerVisits")

  // Phase 17 Reviews & Feedback Relations
  review               Review?                    @relation("BookingReview")
  reviewInvitation     ReviewInvitation?          @relation("BookingReviewInvitation")

  // Phase 18 Promotions & Gift Cards Relations
  appliedCoupon        Coupon?                    @relation("BookingAppliedCoupon", fields: [couponId], references: [id], onDelete: SetNull, map: "fk_bookings_coupon")
  couponUsages         CouponUsage[]              @relation("BookingCouponUsages")
  giftCardTransactions GiftCardTransaction[]      @relation("BookingGiftCardTransactions")

  @@unique([salonId, sequenceNumber], map: "uq_bookings_salon_sequence")
  @@index([salonId, bookingDate], map: "idx_bookings_salon_date")
  @@index([branchId, bookingDate], map: "idx_bookings_branch_date")
  @@index([branchId, bookingDate, status], map: "idx_bookings_branch_date_status")
  @@index([customerId, bookingDate], map: "idx_bookings_customer_date")
  @@index([status, bookingDate], map: "idx_bookings_status_date")
  @@index([paymentStatus], map: "idx_bookings_payment_status")
  @@index([deletedAt], map: "idx_bookings_deleted_at")
  @@index([startTime], map: "idx_bookings_start_time")
  @@index([endTime], map: "idx_bookings_end_time")
  @@map("bookings")
}

model BookingItem {
  id                     String        @id @default(uuid()) @db.Uuid
  bookingId              String        @map("booking_id") @db.Uuid
  branchServiceId        String        @map("branch_service_id") @db.Uuid
  staffId                String        @map("staff_id") @db.Uuid
  sequenceOrder          Int           @default(1) @map("sequence_order")
  startTime              DateTime      @map("start_time") @db.Timestamptz
  endTime                DateTime      @map("end_time") @db.Timestamptz
  serviceDurationMinutes Int           @map("service_duration_minutes")
  prepTimeMinutes        Int           @default(0) @map("prep_time_minutes")
  cleanupTimeMinutes     Int           @default(0) @map("cleanup_time_minutes")
  bufferTimeMinutes      Int           @default(0) @map("buffer_time_minutes")
  unitPrice              Int           @default(0) @map("unit_price")
  discountAmount         Int           @default(0) @map("discount_amount")
  finalPrice             Int           @default(0) @map("final_price")
  status                 BookingStatus @default(PENDING)
  version                Int           @default(1)
  createdByUserId        String        @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?       @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz

  booking                Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "fk_booking_items_booking")
  branchService          BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Restrict, map: "fk_booking_items_branch_service")
  staff                  Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict, map: "fk_booking_items_staff")
  createdByUser          User          @relation("CreatedBookingItems", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_booking_items_created_by_user")
  updatedByUser          User?         @relation("UpdatedBookingItems", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_booking_items_updated_by_user")

  // Phase 17 Reviews & Feedback Relations
  reviewItemRatings      ReviewItemRating[]         @relation("BookingItemReviewItemRatings")

  @@index([bookingId], map: "idx_booking_items_booking")
  @@index([staffId], map: "idx_booking_items_staff")
  @@index([branchServiceId], map: "idx_booking_items_branch_service")
  @@index([startTime, endTime], map: "idx_booking_items_start_end")
  @@index([staffId, startTime, endTime], map: "idx_booking_items_staff_time_range")
  @@map("booking_items")
}

model BookingStatusHistory {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  fromStatus         BookingStatus?@map("from_status")
  toStatus           BookingStatus @map("to_status")
  reason             String?
  performedByUserId  String        @map("performed_by_user_id") @db.Uuid
  actorRole          String        @map("actor_role")
  metadata           Json?
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "fk_booking_status_histories_booking")
  performedByUser    User          @relation("PerformedStatusHistories", fields: [performedByUserId], references: [id], onDelete: Restrict, map: "fk_booking_status_histories_user")

  @@index([bookingId], map: "idx_booking_status_histories_booking")
  @@index([bookingId, createdAt(sort: Desc)], map: "idx_booking_status_histories_booking_created")
  @@map("booking_status_histories")
}

model BookingReservationLock {
  id           String    @id @default(uuid()) @db.Uuid
  lockKey      String    @unique(map: "uq_booking_reservation_locks_key") @map("lock_key")
  branchId     String    @map("branch_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  sessionId    String?   @map("session_id")
  bookingId    String?   @map("booking_id") @db.Uuid
  startTime    DateTime  @map("start_time") @db.Timestamptz
  endTime      DateTime  @map("end_time") @db.Timestamptz
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  refreshCount Int       @default(0) @map("refresh_count")
  isReleased   Boolean   @default(false) @map("is_released")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "fk_booking_reservation_locks_booking")
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade, map: "fk_booking_reservation_locks_branch")
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, map: "fk_booking_reservation_locks_staff")
  customer     User      @relation("CustomerReservationLocks", fields: [customerId], references: [id], onDelete: Cascade, map: "fk_booking_reservation_locks_customer")

  @@index([branchId, staffId], map: "idx_booking_reservation_locks_branch_staff")
  @@index([expiresAt], map: "idx_booking_reservation_locks_expires_at")
  @@index([customerId], map: "idx_booking_reservation_locks_customer")
  @@index([isReleased, expiresAt], map: "idx_booking_reservation_locks_released_expires")
  @@map("booking_reservation_locks")
}

model ServiceVariant {
  id               String   @id @default(uuid()) @db.Uuid
  serviceId        String   @map("service_id") @db.Uuid
  variantName      String   @map("variant_name")
  priceMultiplier  Decimal  @default(1.00) @map("price_multiplier") @db.Decimal(5, 2)
  durationMinutes  Int      @map("duration_minutes")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, map: "fk_service_variants_service")

  @@index([serviceId], map: "idx_service_variants_service_id")
  @@map("service_variants")
}

model Appointment {
  id                String                @id @default(uuid()) @db.Uuid
  bookingNumber     String                @unique(map: "uq_appointments_number") @map("booking_number")
  customerId        String                @map("customer_id") @db.Uuid
  branchId          String                @map("branch_id") @db.Uuid
  staffAssignmentId String                @map("staff_assignment_id") @db.Uuid
  appointmentDate   DateTime              @map("appointment_date") @db.Date
  startTime         DateTime              @map("start_time") @db.Time
  endTime           DateTime              @map("end_time") @db.Time
  status            AppointmentStatus     @default(PENDING)
  notes             String?

  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz
  createdById       String?               @map("created_by_id") @db.Uuid
  updatedById       String?               @map("updated_by_id") @db.Uuid
  version           Int                   @default(1)

  customer          User                  @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_appointments_customer")
  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict, map: "fk_appointments_branch")
  staffAssignment   StaffBranchAssignment @relation("AssignmentAppointments", fields: [staffAssignmentId], references: [id], onDelete: Restrict, map: "fk_appointments_staff_assignment")
  items             AppointmentItem[]
  statusLogs        AppointmentStatusLog[]
  couponUsage       CouponUsage?
  review            Review?

  @@index([branchId, appointmentDate], map: "idx_appointments_branch_date")
  @@index([customerId], map: "idx_appointments_customer")
  @@map("appointments")
}

model AppointmentItem {
  id               String        @id @default(uuid()) @db.Uuid
  appointmentId    String        @map("appointment_id") @db.Uuid
  branchServiceId  String        @map("branch_service_id") @db.Uuid
  price            Decimal       @db.Decimal(12, 2)
  durationMinutes  Int           @map("duration_minutes")

  appointment      Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade, map: "fk_appointment_items_appointment")
  branchService    BranchService @relation(fields: [branchServiceId], references: [id], onDelete: Restrict, map: "fk_appointment_items_branch_service")

  @@map("appointment_items")
}

model AppointmentStatusLog {
  id               String            @id @default(uuid()) @db.Uuid
  appointmentId    String            @map("appointment_id") @db.Uuid
  fromStatus       AppointmentStatus @map("from_status")
  toStatus         AppointmentStatus @map("to_status")
  changedById      String            @map("changed_by_id") @db.Uuid
  reason           String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  appointment      Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade, map: "fk_appointment_status_logs_appointment")

  @@map("appointment_status_logs")
}

model TaxRegion {
  id                 String    @id @default(uuid()) @db.Uuid
  regionCode         String    @unique(map: "uq_tax_regions_code") @map("region_code")
  countryCode        String    @default("IN") @map("country_code")
  taxName            String    @map("tax_name")
  taxRatePercentage  Decimal   @map("tax_rate_percentage") @db.Decimal(5, 2)

  @@map("tax_regions")
}

// ==========================================
// PAYMENTS & REFUNDS DOMAIN (PHASE 14)
// ==========================================

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  paymentCode      String         @unique(map: "uq_payments_code") @map("payment_code") @db.VarChar(32)
  bookingId        String         @map("booking_id") @db.Uuid
  salonId          String         @map("salon_id") @db.Uuid
  branchId         String         @map("branch_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  status           PaymentStatus  @default(UNPAID)
  paymentMethod    PaymentMethod  @map("payment_method")
  provider         PaymentProvider
  currency         String         @default("INR") @db.VarChar(3)
  amountTotal      Int            @map("amount_total")
  amountPaid       Int            @default(0) @map("amount_paid")
  amountRefunded   Int            @default(0) @map("amount_refunded")
  amountDue        Int            @default(0) @map("amount_due")
  isPartialAllowed Boolean        @default(false) @map("is_partial_allowed")
  idempotencyKey   String         @unique(map: "uq_payments_idempotency_key") @map("idempotency_key")
  version          Int            @default(1)
  createdByUserId  String         @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?        @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz

  booking          Booking        @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_payments_booking")
  salon            Salon          @relation("SalonPayments", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_payments_salon")
  branch           Branch         @relation("BranchPayments", fields: [branchId], references: [id], onDelete: Restrict, map: "fk_payments_branch")
  customer         User           @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_payments_customer")
  createdByUser    User           @relation("CreatedPayments", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_payments_created_by_user")
  updatedByUser    User?          @relation("UpdatedPayments", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_payments_updated_by_user")

  transactions     PaymentTransaction[]
  refunds          Refund[]
  invoices         Invoice[]
  auditLogs        PaymentAudit[]

  @@index([paymentCode], map: "idx_payments_code")
  @@index([bookingId], map: "idx_payments_booking")
  @@index([salonId], map: "idx_payments_salon")
  @@index([branchId], map: "idx_payments_branch")
  @@index([customerId], map: "idx_payments_customer")
  @@index([status], map: "idx_payments_status")
  @@index([provider], map: "idx_payments_provider")
  @@index([createdAt(sort: Desc)], map: "idx_payments_created_at")
  @@index([deletedAt], map: "idx_payments_deleted_at")
  @@index([idempotencyKey], map: "idx_payments_idempotency_key")
  @@map("payments")
}

model PaymentTransaction {
  id                     String         @id @default(uuid()) @db.Uuid
  paymentId              String         @map("payment_id") @db.Uuid
  providerTransactionId String?        @unique(map: "uq_payment_transactions_provider_tx_id") @map("provider_transaction_id")
  gatewayReference       String?        @map("gateway_reference")
  authorizationReference String?        @map("authorization_reference")
  paymentMethod          PaymentMethod  @map("payment_method")
  provider               PaymentProvider
  amount                 Int
  currency               String         @default("INR") @db.VarChar(3)
  requestPayload         Json?          @map("request_payload")
  responsePayload        Json?          @map("response_payload")
  status                 PaymentStatus  @default(PENDING)
  processedAt            DateTime?      @map("processed_at") @db.Timestamptz
  version                Int            @default(1)
  createdByUserId        String         @map("created_by_user_id") @db.Uuid
  updatedByUserId        String?        @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz

  payment                Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "fk_payment_transactions_payment")
  createdByUser          User           @relation("CreatedPaymentTransactions", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_payment_transactions_created_by_user")
  updatedByUser          User?          @relation("UpdatedPaymentTransactions", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_payment_transactions_updated_by_user")

  @@index([paymentId], map: "idx_payment_transactions_payment")
  @@index([providerTransactionId], map: "idx_payment_transactions_provider_tx_id")
  @@index([gatewayReference], map: "idx_payment_transactions_gateway_ref")
  @@index([status], map: "idx_payment_transactions_status")
  @@index([createdAt(sort: Desc)], map: "idx_payment_transactions_created_at")
  @@map("payment_transactions")
}

model Refund {
  id                 String        @id @default(uuid()) @db.Uuid
  refundCode         String        @unique(map: "uq_refunds_code") @map("refund_code") @db.VarChar(32)
  paymentId          String        @map("payment_id") @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  amount             Int
  currency           String        @default("INR") @db.VarChar(3)
  reason             String?
  gatewayRefundId    String?       @map("gateway_refund_id")
  provider           PaymentProvider
  status             RefundStatus  @default(PENDING)
  processedByUserId  String        @map("processed_by_user_id") @db.Uuid
  processedAt        DateTime?     @map("processed_at") @db.Timestamptz
  version            Int           @default(1)
  createdByUserId    String        @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?       @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz

  payment            Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "fk_refunds_payment")
  booking            Booking       @relation("BookingRefunds", fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_refunds_booking")
  processedByUser    User          @relation("ProcessedRefunds", fields: [processedByUserId], references: [id], onDelete: Restrict, map: "fk_refunds_processed_by_user")
  createdByUser      User          @relation("CreatedRefunds", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_refunds_created_by_user")
  updatedByUser      User?         @relation("UpdatedRefunds", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_refunds_updated_by_user")

  @@index([paymentId], map: "idx_refunds_payment")
  @@index([bookingId], map: "idx_refunds_booking")
  @@index([status], map: "idx_refunds_status")
  @@index([createdAt(sort: Desc)], map: "idx_refunds_created_at")
  @@map("refunds")
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique(map: "uq_invoices_number") @map("invoice_number")
  paymentId          String        @map("payment_id") @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  salonId            String        @map("salon_id") @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  subtotal           Int           @default(0)
  discount           Int           @default(0)
  cgst               Int           @default(0)
  sgst               Int           @default(0)
  igst               Int           @default(0)
  taxTotal           Int           @default(0) @map("tax_total")
  grandTotal         Int           @default(0) @map("grand_total")
  pdfStorageUrl      String?       @map("pdf_storage_url")
  status             InvoiceStatus @default(DRAFT)
  issuedAt           DateTime?     @map("issued_at") @db.Timestamptz
  version            Int           @default(1)
  createdByUserId    String        @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?       @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz

  payment            Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "fk_invoices_payment")
  booking            Booking       @relation("BookingInvoices", fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_invoices_booking")
  salon              Salon         @relation("SalonInvoices", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_invoices_salon")
  branch             Branch        @relation("BranchInvoices", fields: [branchId], references: [id], onDelete: Restrict, map: "fk_invoices_branch")
  customer           User          @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_invoices_customer")
  createdByUser      User          @relation("CreatedInvoices", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "fk_invoices_created_by_user")
  updatedByUser      User?         @relation("UpdatedInvoices", fields: [updatedByUserId], references: [id], onDelete: SetNull, map: "fk_invoices_updated_by_user")

  // Phase 18 Promotions & Gift Cards Relations
  couponUsages         CouponUsage[]              @relation("InvoiceCouponUsages")
  giftCardTransactions GiftCardTransaction[]      @relation("InvoiceGiftCardTransactions")

  @@index([invoiceNumber], map: "idx_invoices_number")
  @@index([paymentId], map: "idx_invoices_payment")
  @@index([bookingId], map: "idx_invoices_booking")
  @@map("invoices")
}

model PaymentWebhookLog {
  id               String          @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  eventId          String?         @unique(map: "uq_payment_webhook_logs_event_id") @map("event_id")
  signature        String
  payload          Json
  isProcessed      Boolean         @default(false) @map("is_processed")
  processingError  String?         @map("processing_error")
  receivedAt       DateTime        @default(now()) @map("received_at") @db.Timestamptz

  @@index([eventId], map: "idx_payment_webhook_logs_event_id")
  @@index([provider], map: "idx_payment_webhook_logs_provider")
  @@index([isProcessed], map: "idx_payment_webhook_logs_is_processed")
  @@index([receivedAt(sort: Desc)], map: "idx_payment_webhook_logs_received_at")
  @@map("payment_webhook_logs")
}

model PaymentAudit {
  id               String   @id @default(uuid()) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  action           String
  actorUserId      String   @map("actor_user_id") @db.Uuid
  previousState    String?  @map("previous_state")
  newState         String?  @map("new_state")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "fk_payment_audits_payment")
  actorUser        User     @relation("PaymentAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "fk_payment_audits_actor")

  @@index([paymentId], map: "idx_payment_audits_payment")
  @@index([createdAt(sort: Desc)], map: "idx_payment_audits_created_at")
  @@map("payment_audits")
}

// ==========================================
// REVIEWS & REPUTATION MANAGEMENT (PHASE 17)
// ==========================================

model Review {
  id                   String                  @id @default(uuid()) @db.Uuid
  salonId              String                  @map("salon_id") @db.Uuid
  branchId             String                  @map("branch_id") @db.Uuid
  bookingId            String?                 @unique(map: "uq_reviews_booking") @map("booking_id") @db.Uuid
  appointmentId        String?                 @unique(map: "uq_reviews_appointment") @map("appointment_id") @db.Uuid
  customerId           String                  @map("customer_id") @db.Uuid
  overallRating        Int                     @map("overall_rating")
  reviewTitle          String?                 @map("review_title")
  reviewComment        String?                 @map("review_comment")
  cleanlinessRating    Int?                    @map("cleanliness_rating")
  hospitalityRating    Int?                    @map("hospitality_rating")
  valueRating          Int?                    @map("value_rating")
  ambienceRating       Int?                    @map("ambience_rating")
  status               ReviewStatus            @default(PUBLISHED)
  isVerifiedPurchase   Boolean                 @default(true) @map("is_verified_purchase")
  isAnonymous          Boolean                 @default(false) @map("is_anonymous")
  helpfulVotesCount    Int                     @default(0) @map("helpful_votes_count")
  publishedAt          DateTime?               @default(now()) @map("published_at") @db.Timestamptz
  editedAt             DateTime?               @map("edited_at") @db.Timestamptz
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz

  salon                Salon                   @relation("SalonReviews", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_reviews_salon")
  branch               Branch                  @relation("BranchReviews", fields: [branchId], references: [id], onDelete: Restrict, map: "fk_reviews_branch")
  booking              Booking?                @relation("BookingReview", fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_reviews_booking")
  appointment          Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull, map: "fk_reviews_appointment")
  customer             User                    @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Restrict, map: "fk_reviews_customer")

  reply                ReviewReply?
  itemRatings          ReviewItemRating[]
  mediaAttachments     ReviewMediaAttachment[]
  helpfulVotes         ReviewHelpfulVote[]
  flags                ReviewFlag[]
  dispute              ReviewDispute?

  @@index([salonId, status], map: "idx_reviews_salon_status")
  @@index([branchId, status], map: "idx_reviews_branch_status")
  @@index([customerId], map: "idx_reviews_customer")
  @@index([overallRating], map: "idx_reviews_overall_rating")
  @@index([status, publishedAt(sort: Desc)], map: "idx_reviews_status_published_at")
  @@index([deletedAt], map: "idx_reviews_deleted_at")
  @@map("reviews")
}

model ReviewItemRating {
  id                   String                  @id @default(uuid()) @db.Uuid
  reviewId             String                  @map("review_id") @db.Uuid
  bookingItemId        String?                 @map("booking_item_id") @db.Uuid
  serviceId            String                  @map("service_id") @db.Uuid
  staffId              String?                 @map("staff_id") @db.Uuid
  ratingStars          Int                     @map("rating_stars")
  itemComment          String?                 @map("item_comment")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  review               Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_review_item_ratings_review")
  bookingItem          BookingItem?            @relation("BookingItemReviewItemRatings", fields: [bookingItemId], references: [id], onDelete: SetNull, map: "fk_review_item_ratings_booking_item")
  service              Service                 @relation("ServiceReviewItemRatings", fields: [serviceId], references: [id], onDelete: Restrict, map: "fk_review_item_ratings_service")
  staff                Staff?                  @relation("StaffReviewItemRatings", fields: [staffId], references: [id], onDelete: SetNull, map: "fk_review_item_ratings_staff")

  @@index([reviewId], map: "idx_review_item_ratings_review")
  @@index([serviceId], map: "idx_review_item_ratings_service")
  @@index([staffId], map: "idx_review_item_ratings_staff")
  @@map("review_item_ratings")
}

model ReviewMediaAttachment {
  id                   String                  @id @default(uuid()) @db.Uuid
  reviewId             String                  @map("review_id") @db.Uuid
  mediaId              String                  @map("media_id") @db.Uuid
  caption              String?
  isBeforePhoto        Boolean                 @default(false) @map("is_before_photo")
  isAfterPhoto         Boolean                 @default(false) @map("is_after_photo")
  displayOrder         Int                     @default(0) @map("display_order")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz

  review               Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_review_media_attachments_review")
  media                Media                   @relation("MediaReviewAttachments", fields: [mediaId], references: [id], onDelete: Restrict, map: "fk_review_media_attachments_media")

  @@index([reviewId], map: "idx_review_media_attachments_review")
  @@map("review_media_attachments")
}

model ReviewReply {
  id                   String                  @id @default(uuid()) @db.Uuid
  reviewId             String                  @unique(map: "uq_review_replies_review") @map("review_id") @db.Uuid
  salonId              String                  @map("salon_id") @db.Uuid
  responderUserId      String                  @map("responder_user_id") @db.Uuid
  replyText            String                  @map("reply_text")
  publishedAt          DateTime                @default(now()) @map("published_at") @db.Timestamptz
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz

  review               Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_review_replies_review")
  salon                Salon                   @relation("SalonReviewReplies", fields: [salonId], references: [id], onDelete: Restrict, map: "fk_review_replies_salon")
  responderUser        User                    @relation("ResponderUserReplies", fields: [responderUserId], references: [id], onDelete: Restrict, map: "fk_review_replies_responder_user")

  @@index([salonId], map: "idx_review_replies_salon")
  @@map("review_replies")
}

model ReviewHelpfulVote {
  id                   String                  @id @default(uuid()) @db.Uuid
  reviewId             String                  @map("review_id") @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  isHelpful            Boolean                 @default(true) @map("is_helpful")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz

  review               Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_review_helpful_votes_review")
  user                 User                    @relation("UserHelpfulVotes", fields: [userId], references: [id], onDelete: Cascade, map: "fk_review_helpful_votes_user")

  @@unique([reviewId, userId], map: "uq_review_helpful_votes_user")
  @@index([reviewId], map: "idx_review_helpful_votes_review")
  @@map("review_helpful_votes")
}

model ReviewFlag {
  id                   String                  @id @default(uuid()) @db.Uuid
  reviewId             String                  @map("review_id") @db.Uuid
  reportedByUserId     String                  @map("reported_by_user_id") @db.Uuid
  reasonCategory       ReviewFlagReason        @map("reason_category")
  explanation          String?
  status               ReviewFlagStatus        @default(PENDING)
  resolutionNotes      String?                 @map("resolution_notes")
  resolvedByUserId     String?                 @map("resolved_by_user_id") @db.Uuid
  resolvedAt           DateTime?               @map("resolved_at") @db.Timestamptz
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  review               Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade, map: "fk_review_flags_review")
  reportedByUser       User                    @relation("ReportedReviewFlags", fields: [reportedByUserId], references: [id], onDelete: Restrict, map: "fk_review_flags_reported_by_user")
  resolvedByUser       User?                   @relation("ResolvedReviewFlags", fields: [resolvedByUserId], references: [id], onDelete: SetNull, map: "fk_review_flags_resolved_by_user")

  @@index([reviewId], map: "idx_review_flags_review")
