  coupon           Coupon       @relation(fields: [couponId], references: [id], onDelete: Cascade, map: "fk_coupon_service_apps_coupon")
  service          Service      @relation("ServiceCouponApplicabilities", fields: [serviceId], references: [id], onDelete: Cascade, map: "fk_coupon_service_apps_service")

  @@unique([couponId, serviceId], map: "uq_coupon_service_apps_coupon_service")
  @@index([couponId], map: "idx_coupon_service_apps_coupon")
  @@index([serviceId], map: "idx_coupon_service_apps_service")
  @@map("coupon_service_applicabilities")
}

model CouponCategoryApplicability {
