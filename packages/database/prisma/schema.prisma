model Notification {
  id               String               @id @default(uuid()) @db.Uuid
  salonId          String?              @map("salon_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  templateId       String?              @map("template_id") @db.Uuid
  channel          NotificationChannel  @default(PUSH)
  priority         NotificationPriority @default(NORMAL)
  category         NotificationCategory @default(SYSTEM)
  title            String
  body             String               @db.Text
  idempotencyKey   String?              @unique(map: "uq_notifications_idempotency_key") @map("idempotency_key") @db.VarChar(128)
  metadata         Json?                @map("metadata")
  scheduledAt      DateTime?            @map("scheduled_at") @db.Timestamptz
  readAt           DateTime?            @map("read_at") @db.Timestamptz
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz

  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_notifications_user")
  salon            Salon?               @relation("SalonNotifications", fields: [salonId], references: [id], onDelete: Cascade, map: "fk_notifications_salon")
  template         NotificationTemplate?@relation(fields: [templateId], references: [id], onDelete: SetNull, map: "fk_notifications_template")
  deliveries       NotificationDelivery[]

  @@index([userId, readAt], map: "idx_notifications_user_read")
  @@index([salonId], map: "idx_notifications_salon")
  @@index([category], map: "idx_notifications_category")
  @@index([priority], map: "idx_notifications_priority")
  @@index([createdAt(sort: Desc)], map: "idx_notifications_created_at")
  @@index([deletedAt], map: "idx_notifications_deleted_at")
  @@map("notifications")
}

model NotificationDelivery {
  id                 String              @id @default(uuid()) @db.Uuid
  notificationId     String              @map("notification_id") @db.Uuid
