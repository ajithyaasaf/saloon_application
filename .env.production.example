# ==============================================================================
# Saloon Platform — Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.production on production deployment environments.
# NEVER commit real production secrets or API keys to source control.

# Application Configuration
NODE_ENV=production
APP_PORT=3000
APP_PREFIX=api
APP_CORS_ORIGINS=https://salon.saloon.godivatech.com,https://admin.saloon.godivatech.com

# PostgreSQL Database Configuration
DATABASE_USER=saloon_prod_user
DATABASE_PASSWORD=replace_with_strong_database_password
DATABASE_NAME=saloon_prod_db
DATABASE_URL=postgresql://saloon_prod_user:replace_with_strong_database_password@postgres:5432/saloon_prod_db?schema=public&connection_limit=25

# Redis Cache & Distributed Lock Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=replace_with_strong_redis_password

# JWT Authentication Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=replace_with_cryptographically_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_cryptographically_random_refresh_secret_min_32_chars

# Razorpay Payment Gateway (Production)
RAZORPAY_KEY_ID=rzp_live_replace_with_live_key
RAZORPAY_KEY_SECRET=replace_with_live_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret

# Twilio SMS / WhatsApp Service
TWILIO_ACCOUNT_SID=AC_replace_with_live_twilio_sid
TWILIO_AUTH_TOKEN=replace_with_live_twilio_auth_token
TWILIO_FROM_NUMBER=+919876543210

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=saloon-production-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@saloon-production-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 / AWS S3 Object Storage
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_key
R2_BUCKET_NAME=saloon-production-assets
R2_PUBLIC_DOMAIN=https://assets.saloon.godivatech.com

# Frontend Public API Endpoints
NEXT_PUBLIC_API_URL=https://api.saloon.godivatech.com
EXPO_PUBLIC_API_URL=https://api.saloon.godivatech.com
